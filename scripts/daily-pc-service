#!/bin/bash
# Ubuntu 24.04 Cloud PC 24/7 Watchdog Service Daemon
# Continuously monitors and auto-heals core desktop, audio, bridge, gateway, and tunnel processes.

SERVICE_DIR="/workspaces/Work"
USER_HOME="/home/codespace"
LOG_DIR="${USER_HOME}/.vnc"

mkdir -p "$LOG_DIR"

log_msg() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [CloudPC Watchdog] $1" >> "${LOG_DIR}/daily-service.log"
}

check_and_start_vnc() {
    if ! pgrep -f "Xvnc :1" > /dev/null; then
        log_msg "Restarting TigerVNC Server on :1..."
        vncserver -kill :1 2>/dev/null || true
        rm -f /tmp/.X1-lock /tmp/.X11-unix/X1 2>/dev/null || true
        vncserver :1 -geometry 1920x1080 -depth 24 -localhost no -SecurityTypes None >> "${LOG_DIR}/vnc.log" 2>&1
    fi
}

check_and_start_audio() {
    if ! pgrep -f "audio_streamer.py" > /dev/null; then
        log_msg "Restarting Audio Streamer..."
        nohup python3 "${SERVICE_DIR}/scripts/audio_streamer.py" >> "${LOG_DIR}/audio.log" 2>&1 &
    fi
}

check_and_start_websockify() {
    if ! pgrep -f "websockify.*6081" > /dev/null; then
        log_msg "Restarting Websockify VNC Bridge..."
        nohup websockify --web /usr/share/novnc 6081 127.0.0.1:5901 >> "${LOG_DIR}/websockify.log" 2>&1 &
    fi
}

check_and_start_nginx() {
    if ! pgrep -f "nginx: master process" > /dev/null; then
        log_msg "Restarting Nginx Unified Gateway..."
        sudo service nginx restart >> "${LOG_DIR}/nginx.log" 2>&1
    fi
}

check_and_start_tunnel() {
    if ! pgrep -f "cloudflared tunnel" > /dev/null; then
        log_msg "Restarting Cloudflare Public Tunnel..."
        nohup cloudflared tunnel --url http://127.0.0.1:6080 >> "${LOG_DIR}/tunnel.log" 2>&1 &
    fi
}

log_msg "Watchdog service started."

while true; do
    check_and_start_vnc
    check_and_start_audio
    check_and_start_websockify
    check_and_start_nginx
    check_and_start_tunnel
    sleep 5
done
