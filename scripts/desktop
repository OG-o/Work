#!/usr/bin/env bash
# /usr/local/bin/desktop - Real OS & Desktop Manager (postmarketOS UEFI & Cinnamon 6.0)
set -euo pipefail

VNC_PORT=5901
WEB_PORT=6080
DISPLAY_NUM=":1"
LOG_DIR="$HOME/.vnc"
CLOUDFLARE_LOG="$LOG_DIR/cloudflared.log"
PMOS_IMG="$HOME/.local/var/pmbootstrap/chroot_native/home/pmos/rootfs/qemu-amd64.img"
OVMF_FD="/usr/share/ovmf/OVMF.fd"

[ ! -f "$OVMF_FD" ] && OVMF_FD="/usr/share/OVMF/OVMF_CODE_4M.fd"
[ ! -f "$OVMF_FD" ] && OVMF_FD="/usr/share/qemu/OVMF.fd"

mkdir -p "$LOG_DIR"

print_banner() {
  echo -e "\033[1;36m================================================================\033[0m"
  echo -e "\033[1;32m   📱  GENUINE POSTMARKETOS LINUX (UEFI + KVM GRAPHICAL GUI)    \033[0m"
  echo -e "\033[1;36m================================================================\033[0m"
}

is_vnc_running() {
  ss -tlpn 2>/dev/null | grep -q ":${VNC_PORT} "
}

is_web_running() {
  ss -tlpn 2>/dev/null | grep -q ":${WEB_PORT} "
}

get_public_url() {
  if [ -f "$CLOUDFLARE_LOG" ]; then
    grep -o "https://[a-zA-Z0-9.-]*\.trycloudflare\.com" "$CLOUDFLARE_LOG" | tail -n 1 || true
  fi
}

start_postmarketos() {
  print_banner
  echo -e "\033[1;33m[*] Starting Genuine postmarketOS Mobile Linux with UEFI Graphical Shell...\033[0m"

  sudo chmod 666 /dev/kvm 2>/dev/null || true
  sudo chmod 666 "$PMOS_IMG" 2>/dev/null || true

  # Stop any previous instances
  pkill -f "qemu-system-x86_64" 2>/dev/null || true
  pkill -f "Xtigervnc" 2>/dev/null || true
  sleep 1

  echo -e "[*] Booting postmarketOS with UEFI OVMF Firmware & KVM..."
  nohup qemu-system-x86_64 \
    -enable-kvm \
    -cpu host \
    -smp 4 \
    -m 4G \
    -drive if=pflash,format=raw,readonly=on,file="$OVMF_FD" \
    -drive file="$PMOS_IMG",format=raw,if=virtio \
    -device virtio-vga \
    -device virtio-tablet-pci \
    -device virtio-keyboard-pci \
    -netdev user,id=net \
    -device virtio-net-pci,netdev=net \
    -vnc :1 \
    -daemonize > "$LOG_DIR/pmos-qemu.log" 2>&1
  sleep 3

  start_gateway
  show_urls "postmarketOS (Phosh Touch UI)"
}

start_cinnamon() {
  print_banner
  echo -e "\033[1;33m[*] Starting Genuine Modern Cinnamon Desktop OS...\033[0m"

  pkill -f "qemu-system-x86_64" 2>/dev/null || true
  pkill -f "Xtigervnc" 2>/dev/null || true
  sleep 1

  sudo mkdir -p /tmp/.X11-unix 2>/dev/null || true
  sudo chmod 1777 /tmp/.X11-unix 2>/dev/null || true

  echo -e "[*] Launching display server on ${DISPLAY_NUM}..."
  tigervncserver "${DISPLAY_NUM}" \
    -geometry 1920x1080 \
    -depth 24 \
    -localhost no \
    -SecurityTypes None \
    --I-KNOW-THIS-IS-INSECURE > "$LOG_DIR/vnc.log" 2>&1
  sleep 1

  start_gateway
  show_urls "Cinnamon Desktop OS"
}

start_gateway() {
  # 1. noVNC index redirect
  cat << 'EOF' | sudo tee /usr/share/novnc/index.html > /dev/null
<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta http-equiv="refresh" content="0; url=vnc.html?autoconnect=true&resize=remote&reconnect=true&path=websockify">
<title>postmarketOS Mobile Linux</title>
</head>
<body style="background:#181825; color:#cdd6f4; font-family:sans-serif; text-align:center; padding-top:20vh;">
  <h2>Connecting to postmarketOS...</h2>
  <p><a style="color:#89b4fa;" href="vnc.html?autoconnect=true&resize=remote&reconnect=true&path=websockify">Click here to connect</a></p>
</body>
</html>
EOF

  # 2. Start Websockify if not running
  if ! is_web_running; then
    echo -e "[*] Starting HTML5 Web Gateway on Port ${WEB_PORT}..."
    pkill -f "websockify" 2>/dev/null || true
    nohup /usr/bin/websockify --web /usr/share/novnc ${WEB_PORT} 127.0.0.1:${VNC_PORT} > "$LOG_DIR/novnc.log" 2>&1 &
    disown
    sleep 2
  fi

  # 3. Start Cloudflare Tunnel if not running
  if ! pgrep -f "cloudflared.*${WEB_PORT}" >/dev/null; then
    echo -e "[*] Provisioning Global Cloud Gateway..."
    pkill -f "cloudflared.*${WEB_PORT}" 2>/dev/null || true
    rm -f "$CLOUDFLARE_LOG"
    nohup /usr/local/bin/cloudflared tunnel --edge-ip-version 4 --url "http://127.0.0.1:${WEB_PORT}" > "$CLOUDFLARE_LOG" 2>&1 < /dev/null &
    disown
    for i in {1..20}; do
      sleep 1
      PUBLIC_URL=$(get_public_url)
      [ -n "$PUBLIC_URL" ] && break
    done
  fi
}

show_urls() {
  local os_name="${1:-postmarketOS}"
  PUBLIC_URL=$(get_public_url)

  echo ""
  echo -e "\033[1;32m🎉 ${os_name} IS ACTIVE & RUNNING!\033[0m"
  echo ""
  echo -e "\033[1;37m👉 TAP THIS LINK TO OPEN ${os_name} IN YOUR BROWSER:\033[0m"
  
  if [ -n "$PUBLIC_URL" ]; then
    echo ""
    echo -e "    \033[1;32m\033[4m${PUBLIC_URL}\033[0m"
    echo ""
    if command -v qrencode &>/dev/null; then
      echo -e "  \033[1;35m📲 Or scan this QR code with your phone camera:\033[0m"
      qrencode -t ANSIUTF8 "${PUBLIC_URL}" || true
      echo ""
    fi
  else
    echo -e "    \033[1;31m[!] Gateway is initializing, run 'desktop status' in a moment.\033[0m"
  fi

  echo -e "\033[1;33m🔑 Default Login Password: 'user'\033[0m"
  echo -e "\033[1;30mCommands: 'desktop postmarketos' | 'desktop cinnamon' | 'desktop stop' | 'desktop status'\033[0m"
  echo -e "\033[1;36m================================================================\033[0m"
}

stop_desktop() {
  print_banner
  echo -e "\033[1;31m[*] Stopping OS Environment...\033[0m"
  pkill -f "cloudflared.*${WEB_PORT}" 2>/dev/null || true
  pkill -f "websockify" 2>/dev/null || true
  pkill -f "qemu-system-x86_64" 2>/dev/null || true
  tigervncserver -kill "${DISPLAY_NUM}" >/dev/null 2>&1 || true
  pkill -u "$USER" -f "cinnamon" 2>/dev/null || true
  rm -f "$CLOUDFLARE_LOG"
  echo -e "\033[1;32m[✓] All OS services stopped.\033[0m"
}

case "${1:-postmarketos}" in
  postmarketos|pmos|start)
    start_postmarketos
    ;;
  cinnamon)
    start_cinnamon
    ;;
  stop)
    stop_desktop
    ;;
  restart)
    stop_desktop
    sleep 1
    start_postmarketos
    ;;
  status|url|urls)
    print_banner
    if is_vnc_running && is_web_running; then
      echo -e "\033[1;32m[●] Status: ACTIVE & RUNNING\033[0m"
      show_urls "Current OS"
    else
      echo -e "\033[1;31m[○] Status: INACTIVE (Run 'desktop postmarketos' to launch)\033[0m"
    fi
    ;;
  *)
    echo "Usage: desktop {postmarketos|cinnamon|stop|restart|status}"
    exit 1
    ;;
esac
