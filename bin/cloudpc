#!/bin/bash
# ==============================================================================
# Cloud PC Management CLI Utility
# Control, inspect, and manage your cloud workstation desktop environment.
# ==============================================================================

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

print_header() {
    echo -e "${CYAN}${BOLD}"
    echo "========================================================"
    echo "       🚀 Ubuntu 24.04 Cloud PC Workstation CLI        "
    echo "========================================================"
    echo -e "${NC}"
}

start_services() {
    print_header
    echo -e "${YELLOW}Starting Cloud PC services...${NC}"

    # 1. Start Watchdog Daemon (auto-starts everything)
    if ! pgrep -f "daily-pc-service" > /dev/null; then
        bash -c "setsid /workspaces/Work/scripts/daily-pc-service </dev/null >/dev/null 2>&1 &"
        echo -e "${GREEN}✔ Watchdog service launched.${NC}"
    else
        echo -e "${GREEN}✔ Watchdog service already running.${NC}"
    fi

    # Trigger immediate heal
    sleep 3

    show_status
}

stop_services() {
    print_header
    echo -e "${RED}Stopping all Cloud PC services...${NC}"
    pkill -f "daily-pc-service" 2>/dev/null || true
    pkill -f "cloudflared" 2>/dev/null || true
    pkill -f "websockify" 2>/dev/null || true
    pkill -f "audio_streamer" 2>/dev/null || true
    vncserver -kill :1 2>/dev/null || true
    pkill -f "Xvnc" 2>/dev/null || true
    pkill -f "Xtigervnc" 2>/dev/null || true
    rm -f /tmp/.X1-lock /tmp/.X11-unix/X1 2>/dev/null || true
    sudo nginx -s stop 2>/dev/null || true
    echo -e "${GREEN}✔ All Cloud PC processes stopped.${NC}"
}

get_tunnel_url() {
    local url=""
    if [ -f "/home/codespace/.vnc/tunnel.log" ]; then
        url=$(grep -o 'https://[-a-z0-9]*\.trycloudflare\.com' /home/codespace/.vnc/tunnel.log | tail -n 1)
    fi
    if [ -z "$url" ] && [ -f "/home/codespace/.vnc/cloudflared.log" ]; then
        url=$(grep -o 'https://[-a-z0-9]*\.trycloudflare\.com' /home/codespace/.vnc/cloudflared.log | tail -n 1)
    fi
    echo "$url"
}

show_status() {
    print_header
    echo -e "${BOLD}Component Status:${NC}"

    # Check VNC
    if pgrep -f "Xvnc :1" > /dev/null || pgrep -f "Xtigervnc :1" > /dev/null; then
        echo -e "  [${GREEN}RUNNING${NC}] VNC Desktop Display Server (:1)"
    else
        echo -e "  [${RED}STOPPED${NC}] VNC Desktop Server"
    fi

    # Check Audio
    if pgrep -f "audio_streamer.py" > /dev/null; then
        echo -e "  [${GREEN}RUNNING${NC}] PulseAudio Live Streamer (Port 5711)"
    else
        echo -e "  [${RED}STOPPED${NC}] PulseAudio Live Streamer"
    fi

    # Check Nginx
    if pgrep -f "nginx: master" > /dev/null; then
        echo -e "  [${GREEN}RUNNING${NC}] Nginx Unified Gateway (Port 6080)"
    else
        echo -e "  [${RED}STOPPED${NC}] Nginx Unified Gateway"
    fi

    # Check XRDP
    if pgrep -f "/usr/sbin/xrdp" > /dev/null; then
        echo -e "  [${GREEN}RUNNING${NC}] Microsoft Remote Desktop (XRDP - Port 3389)"
    else
        echo -e "  [${YELLOW}STOPPED${NC}] Microsoft Remote Desktop (XRDP)"
    fi

    # Check Tunnel
    local tunnel_url=$(get_tunnel_url)
    if [ -n "$tunnel_url" ]; then
        echo -e "  [${GREEN}RUNNING${NC}] Cloudflare Public Edge Gateway"
        echo ""
        echo -e "${CYAN}${BOLD}🌐 Live Access URL (Open in Browser / PWA):${NC}"
        echo -e "👉 ${GREEN}${BOLD}${tunnel_url}${NC}"
    else
        echo -e "  [${YELLOW}WAITING${NC}] Cloudflare Tunnel initializing..."
    fi
    echo ""
}

show_url() {
    local tunnel_url=$(get_tunnel_url)
    if [ -n "$tunnel_url" ]; then
        echo "$tunnel_url"
    else
        echo "Tunnel URL not available yet. Run 'cloudpc status' or 'cloudpc start'."
    fi
}

start_rdp() {
    /workspaces/Work/scripts/pinggy_rdp_tunnel.sh
}

run_health() {
    python3 /workspaces/Work/scripts/system_health_check.py
}

show_logs() {
    echo -e "${CYAN}${BOLD}--- Recent Watchdog Logs ---${NC}"
    tail -n 25 /home/codespace/.vnc/daily-service.log 2>/dev/null || echo "No watchdog logs found."
    echo ""
    echo -e "${CYAN}${BOLD}--- Recent Cloudflare Tunnel Logs ---${NC}"
    tail -n 15 /home/codespace/.vnc/tunnel.log 2>/dev/null || echo "No tunnel logs found."
}

case "$1" in
    start)
        start_services
        ;;
    stop)
        stop_services
        ;;
    restart)
        stop_services
        sleep 2
        start_services
        ;;
    status)
        show_status
        ;;
    url)
        show_url
        ;;
    rdp)
        start_rdp
        ;;
    health)
        run_health
        ;;
    logs)
        show_logs
        ;;
    *)
        print_header
        echo -e "${BOLD}Usage:${NC} cloudpc {start|stop|restart|status|url|rdp|health|logs}"
        echo ""
        echo "Commands:"
        echo "  start    - Launch all Cloud PC services & 24/7 watchdog"
        echo "  stop     - Stop all desktop, audio, and network services"
        echo "  restart  - Restart the entire Cloud PC stack"
        echo "  status   - Check status of VNC, Audio, Nginx, XRDP, and Tunnel"
        echo "  url      - Print the active public web access link"
        echo "  rdp      - Generate live Microsoft Remote Desktop (MSTSC) tunnel"
        echo "  health   - Run comprehensive diagnostic test suite"
        echo "  logs     - Show real-time system and tunnel logs"
        echo ""
        exit 1
        ;;
esac
